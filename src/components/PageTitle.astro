---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro'

const { subtitle } = Astro.locals.starlightRoute.entry.data
---

<DefaultPageTitle />
{subtitle && <p class="article-subtitle">{subtitle}</p>}

<style>
  .article-subtitle {
    margin-block: 0.5rem 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.5;
  }
</style>
